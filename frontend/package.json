{
  "name": "spectrum-lab-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:spectrum-tools": "tsc -p tsconfig.spectrum-tools-validation.json && node --test validation-tests/spectrum-tools.test.mjs",
    "test:ble-targets": "tsc -p tsconfig.ble-validation.json && node --test validation-tests/ble-target-model.test.mjs validation-tests/ble-campaign-policy.test.mjs",
    "test:ble-dataset": "tsc -p tsconfig.ble-validation.json && node --test validation-tests/ble-dataset-studio.test.mjs",
    "test:e2e": "playwright test",
    "test:components": "vitest run --config vitest.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.8.0",
    "tailwind-merge": "^2.0.0",
    "three": "^0.160.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^4.1.10"
  }
}
